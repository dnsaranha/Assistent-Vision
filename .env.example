GEMINI_API_KEY=
PORT=3000

# Firebase Admin SDK: configure ONE option for server-side ID token verification
FIREBASE_PROJECT_ID=
# Option A: path to service-account JSON file (local/server deployment)
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: service-account JSON stored as a hosting secret
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated allowed browser origins; empty means same-origin only
CORS_ORIGINS=
