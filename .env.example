# Gemini API key (server-side only; never use a VITE_ prefix)
GEMINI_API_KEY=
# API_KEY is also accepted for compatibility with the existing Vercel project
API_KEY=

# Firebase Admin SDK used to verify Firebase Authentication ID tokens
FIREBASE_PROJECT_ID=gen-lang-client-0421027303
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: additional allowed browser origins (same-origin Vercel requests work without this)
CORS_ORIGINS=

# Local Express server
PORT=3000

# AdMob / Google AdSense configuration (configured as project secret environment variables)
ADMOB_PUBLISHER_ID=
ADMOB_SLOT_ID=
