GEMINI_API_KEY=
PORT=3000

# Firebase Admin SDK: configure ONE option for server-side ID token verification
FIREBASE_PROJECT_ID=
# Option A: path to service-account JSON file (local/server deployment)
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: service-account JSON stored as a hosting secret
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated allowed browser origins; empty means same-origin only
CORS_ORIGINS=

# Frontend only: URLs of the separately hosted backend.
# Leave empty for same-origin local development.
VITE_API_BASE_URL=
# Use the backend origin with wss:// in production, e.g. wss://your-service.onrender.com
VITE_WS_BASE_URL=
