{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "path": "/users/{userId}",
      "fields": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "lastLoginAt": { "type": "timestamp" }
      },
      "roles": {
        "owner": ["userId"]
      }
    },
    "UserSession": {
      "collection": "sessions",
      "path": "/users/{userId}/sessions/{sessionId}",
      "fields": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "messageCount": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "roles": {
        "owner": ["userId"]
      }
    }
  }
}
